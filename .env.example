# =============================================================
# GeoMondo — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================

# -------------------------------------------------------------
# SUPABASE
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-side only — never expose to client

# -------------------------------------------------------------
# GOOGLE MAPS
# Get key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps Embed API ONLY (do NOT enable Maps JavaScript API — billing risk)
# Restrict key to: HTTP referrers → geomondo.it/*, localhost:3000/*
# -------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -------------------------------------------------------------
# GAME CONFIG
# These control gameplay constants — safe to change without redeployment
# -------------------------------------------------------------
NEXT_PUBLIC_ROUND_DURATION_SECONDS=60       # Sprint mode timer
NEXT_PUBLIC_MAX_SCORE_PER_ROUND=5000        # Max points per round (Classico/Sprint/Italia)
NEXT_PUBLIC_ROUNDS_PER_GAME=5              # Number of rounds per game session

# -------------------------------------------------------------
# i18n
# -------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=it
NEXT_PUBLIC_SUPPORTED_LOCALES=it,en

# -------------------------------------------------------------
# ANALYTICS (optional — add when launching)
# Get from: https://posthog.com
# -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -------------------------------------------------------------
# ADS (optional — add before monetisation phase)
# Get from: https://www.google.com/adsense
# -------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# -------------------------------------------------------------
# DEPLOYMENT
# Set automatically by Vercel — only needed for local testing
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Change to https://geomondo.it in production
